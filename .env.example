PORT=8001

# Base URL of the OpenEMR server (standard API lives under /apis/default, FHIR under /fhir)
OPENEMR_BASE_URL=https://eleven.openemr.io/openemr

# A previously generated OpenEMR bearer token (see the swagger "Authorize" dialog)
OPENEMR_ACCESS_TOKEN=your-bearer-token-here

LOG_LEVEL=info
CORS_ORIGIN=*