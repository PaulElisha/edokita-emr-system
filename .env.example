VERSION=1.0.0

# dev | test | prod. In prod, custom-env loads .env.prod (falls back to .env).
APP_STAGE=dev

PORT=8000
LOCAL_URL=http://localhost
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# OpenEMR — ONE url (site root, no path). Everything else is derived in env.ts:
#   oauth token : $OPENEMR_URL/oauth2/default/token
#   standard API: $OPENEMR_URL/apis/default
#   FHIR R4     : $OPENEMR_URL/apis/default/fhir
# ---------------------------------------------------------------------------
# dev  -> http://localhost:8400
# prod -> https://<openemr-service>.onrender.com
OPENEMR_URL=http://localhost:8400
OPENEMR_CLIENT_ID=Q1M7d7l40f4DJf2ZNXi9pN9jX8ZIJU9We5XGXTxrKAw
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=<openemr admin password>
# Optional; a token is minted and refreshed automatically when this is empty.
OPENEMR_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OAuth2 authorization-code flow (per-user login). Register the redirect URI
# below on your OpenEMR OAuth2 client, then paste the issued client secret.
# ---------------------------------------------------------------------------
OPENEMR_CLIENT_SECRET=<client secret from the registration response>
OPENEMR_REDIRECT_URI=http://localhost:8000/api/openemr/callback
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Appointment booking defaults. OpenEMR calendar identifiers are
# install-specific; list real values via GET /api/appointments/categories,
# GET /api/facilities (admin) and GET /api/list/apptstat.
# ---------------------------------------------------------------------------
OPENEMR_DEFAULT_APPOINTMENT_CATEGORY=5
OPENEMR_DEFAULT_FACILITY=3
OPENEMR_DEFAULT_BILLING_LOCATION=3
# Working-hours model backing booking validation + future slot search.
OPENEMR_WORKING_HOURS_START=09:00
OPENEMR_WORKING_HOURS_END=17:00

# App Postgres (users, OpenEMR tokens). `docker compose up -d postgres`.
DATABASE_URL=postgres://postgres:<postgres password>@localhost:5432/edokita

# ---------------------------------------------------------------------------
# Local Docker stack credentials (docker-compose.yml). Docker Compose reads
# this file to interpolate `${...}`; every var below is required by
# `docker compose up`. Use strong, unique values and never commit them.
# `OE_PASS` is wired to OPENEMR_PASSWORD above.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=<postgres password>
MYSQL_ROOT_PASSWORD=<mysql root password>
MYSQL_PASSWORD=<openemr db password>
