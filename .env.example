VERSION=1.0.0

# Deployment stage: dev | test | prod
# In prod, custom-env loads .env.prod (falling back to .env).
APP_STAGE=dev

PORT=8000

# Public base URL of this API (used for the Swagger server entry)
BASE_URL=https://emr-clinic-management.onrender.com
LOCAL_URL=http://localhost:8000

CORS_ORIGIN=*
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# OpenEMR connection
# ---------------------------------------------------------------------------
# Base URL of the OpenEMR server (standard API under /apis/default, FHIR /fhir)
OPENEMR_BASE_URL=https://<openemr-service>.onrender.com/apis/default

# A previously generated bearer token (optional; auto-refreshed otherwise)
OPENEMR_ACCESS_TOKEN=

# Local OpenEMR (used when APP_STAGE=dev)
LOCAL_OPENEMR_URL=http://localhost:8400
LOCAL_OPENEMR_CLIENT_ID=Q1M7d7l40f4DJf2ZNXi9pN9jX8ZIJU9We5XGXTxrKAw
LOCAL_OPENEMR_AUD_URI=http://localhost:8400/apis/default/fhir

# Production OpenEMR (used when APP_STAGE=prod)
OPENEMR_URL=https://<openemr-service>.onrender.com
OPENEMR_CLIENT_ID=Q1M7d7l40f4DJf2ZNXi9pN9jX8ZIJU9We5XGXTxrKAw
OPENEMR_AUD_URI=https://<openemr-service>.onrender.com/apis/default/fhir
OPENEMR_USERNAME=admin
OPENEMR_PASSWORD=<openemr admin password>

# ---------------------------------------------------------------------------
# Cloud MySQL (Aiven). NOTE: this backend is stateless and does NOT use these;
# they are kept only for parity with the Render Secret File. OpenEMR itself
# consumes them via the Render `openemr` service, not this API.
# ---------------------------------------------------------------------------
MYSQL_HOST=mysql-1bc79121-ireajao-9f74.j.aivencloud.com
MYSQL_PORT=25562
MYSQL_USER=openemr
MYSQL_PASSWORD=<aiven openemr user password>
MYSQL_DATABASE=openemr
