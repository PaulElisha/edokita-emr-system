{
  "name": "hospital-management",
  "version": "1.0.0",
  "description": "Hospital management backend built on top of the OpenEMR API (standard + FHIR R4)",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "esbuild app.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist/app.js",
    "start": "node dist/app.js",
    "dev": "tsx watch app.ts",
    "typecheck": "tsc --noEmit",
    "auth": "tsx src/shared/lib/auth.ts"
  },
  "keywords": [
    "hospital",
    "emr",
    "fhir",
    "openemr",
    "healthcare"
  ],
  "author": "paul elisha",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "custom-env": "^2.0.6",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "pem-to-jwk": "^1.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}