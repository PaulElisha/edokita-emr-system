{
  "name": "hospital-management",
  "version": "1.0.0",
  "description": "Hospital management backend built on top of the OpenEMR API (standard + FHIR R4)",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "esbuild app.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist/app.js",
    "start": "node dist/app.js",
    "dev": "tsx watch app.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth": "tsx src/shared/utils/auth.ts",
    "openemr:scopes": "docker compose run --rm openemr-init",
    "provision": "npm run db:migrate && npm run openemr:scopes"
  },
  "keywords": [
    "hospital",
    "emr",
    "fhir",
    "openemr",
    "healthcare"
  ],
  "author": "paul elisha",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/convert-units": "^2.3.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@epic-web/remember": "^1.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@types/fhir": "^0.0.44",
    "convert-units": "^2.3.4",
    "cors": "^2.8.5",
    "custom-env": "^2.0.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "oauth4webapi": "^3.8.8",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  }
}
