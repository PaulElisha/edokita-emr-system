{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM"
    ],
    "paths": {
      "@*": [
        "./.*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@app/*": [
        "./src/config/app/*"
      ],
      "@auth/*": [
        "./src/config/auth/*"
      ],
      "@db/*": [
        "./src/config/db/*"
      ],
      "@swagger/*": [
        "./src/config/swagger/*"
      ],
      "@error/*": [
        "./src/shared/error/*"
      ],
      "@module/*": [
        "./src/module/*"
      ],
      "@middleware/*": [
        "./src/shared/middleware/*"
      ],
      "@enum/*": [
        "./src/shared/enum/*"
      ]
    },
    "types": ["node", "fhir"],
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Nodenext",
    "moduleResolution": "Nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "env.ts",
    "app.ts",
    "drizzle.config.ts",
    "custom-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}