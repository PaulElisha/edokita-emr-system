{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2024",
      "DOM"
    ],
    "paths": {
      "@*": [
        "./.*"
      ],
      "@webhook/*": [
        "./src/webhook/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@app/*": [
        "./src/config/app/*"
      ],
      "@auth/*": [
        "./src/config/auth/*"
      ],
      "@swagger/*": [
        "./src/config/swagger/*"
      ],
      "@db/*": [
        "./src/config/db/*"
      ],
      "@error/*": [
        "./src/shared/error/*"
      ],
      "@module/*": [
        "./src/module/*"
      ],
      "@middleware/*": [
        "./src/shared/middleware/*"
      ],
      "@enum/*": [
        "./src/shared/enum/*"
      ],
      "@lib/*": [
        "./src/shared/lib/*"
      ],
      "@schema/*": [
        "./src/config/db/schema/*"
      ],
      "@types/*": [
        "./src/shared/types/*"
      ],
    },
    "outDir": "./dist",
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Nodenext",
    "moduleResolution": "Nodenext",
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "env.ts",
    "app.ts",
    "drizzle.config.ts",
    "fasy.d.ts",
    "custom-env.d.ts",
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}